# --- voice (required) ---
# Free tier available: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_...

# --- brain: pick ONE of the three ---
# claude (default, best answers) - https://console.anthropic.com
THIRDCHAIR_BRAIN=claude
ANTHROPIC_API_KEY=sk-ant-...

# groq (FREE tier, very fast) - free key at https://console.groq.com/keys
#THIRDCHAIR_BRAIN=groq
#GROQ_API_KEY=gsk_...
#GROQ_MODEL=llama-3.3-70b-versatile

# ollama (FREE + fully local, no key at all) - https://ollama.com, then: ollama pull llama3.2
#THIRDCHAIR_BRAIN=ollama
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.2

# --- optional ---
# Voice used for spoken answers (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Phrase that summons the copilot mid-meeting
WAKE_PHRASE=hey copilot
# Claude model that powers the answers
THIRDCHAIR_MODEL=claude-opus-5
# Claude reasoning effort: low = fastest spoken answers, high = deepest
THIRDCHAIR_EFFORT=low
# Server port
PORT=8787

# local voice (no keys): whisper.cpp STT + macOS say TTS
#THIRDCHAIR_VOICE=local
#WHISPER_URL=http://localhost:8788
