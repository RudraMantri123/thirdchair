# --- required ---
ELEVENLABS_API_KEY=sk_...
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---
# Voice used for spoken answers (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Phrase that summons the copilot mid-meeting
WAKE_PHRASE=hey copilot
# Claude model that powers the answers
THIRDCHAIR_MODEL=claude-opus-5
# Claude reasoning effort: low = fastest spoken answers, high = deepest
THIRDCHAIR_EFFORT=low
# Server port
PORT=8787
